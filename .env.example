# Optional display name. Environment variables override this file.
KITCHENSOUP_APP_NAME=KitchenSoup

# make local-env generates missing local credentials. Never commit .env.
KITCHENSOUP_POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Host ports; infrastructure stays on the Compose network except RustFS.
KITCHENSOUP_PORT=8000
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Browser-reachable signing endpoint; update when changing the RustFS API port/hostname.
KITCHENSOUP_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
