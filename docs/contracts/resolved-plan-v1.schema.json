{
  "$defs": {
    "PlanModelSource": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Id"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Sha256"
        },
        "kind": {
          "enum": [
            "catalog",
            "huggingface",
            "upload"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "location",
        "revision",
        "license",
        "artifact_id",
        "artifact_sha256"
      ],
      "title": "PlanModelSource",
      "type": "object"
    },
    "Recipe": {
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "$ref": "#/$defs/TrainingParameters"
        },
        "example_kind": {
          "enum": [
            "conversation",
            "document"
          ],
          "title": "Example Kind",
          "type": "string"
        },
        "formatting": {
          "enum": [
            "model_chat_template",
            "plain_text"
          ],
          "title": "Formatting",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "enum": [
            "conversation_imitation",
            "task_from_examples",
            "learn_from_documents"
          ],
          "title": "Intent",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "objective": {
          "enum": [
            "final_assistant",
            "all_text_tokens"
          ],
          "title": "Objective",
          "type": "string"
        },
        "overlength": {
          "const": "reject",
          "default": "reject",
          "title": "Overlength",
          "type": "string"
        },
        "schema": {
          "const": "kitchensoup.recipe/v1",
          "title": "Schema",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "id",
        "version",
        "name",
        "intent",
        "example_kind",
        "objective",
        "formatting",
        "defaults"
      ],
      "title": "Recipe",
      "type": "object"
    },
    "TrainingParameters": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "maximum": 64,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "epochs": {
          "maximum": 20,
          "minimum": 1,
          "title": "Epochs",
          "type": "integer"
        },
        "gradient_accumulation_steps": {
          "maximum": 256,
          "minimum": 1,
          "title": "Gradient Accumulation Steps",
          "type": "integer"
        },
        "learning_rate": {
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "title": "Learning Rate",
          "type": "number"
        },
        "lora_alpha": {
          "maximum": 512,
          "minimum": 1,
          "title": "Lora Alpha",
          "type": "integer"
        },
        "lora_dropout": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Lora Dropout",
          "type": "number"
        },
        "lora_rank": {
          "maximum": 256,
          "minimum": 1,
          "title": "Lora Rank",
          "type": "integer"
        },
        "lora_target": {
          "const": "all_linear",
          "default": "all_linear",
          "title": "Lora Target",
          "type": "string"
        },
        "max_sequence_length": {
          "maximum": 32768,
          "minimum": 128,
          "title": "Max Sequence Length",
          "type": "integer"
        },
        "optimizer": {
          "const": "adamw",
          "default": "adamw",
          "title": "Optimizer",
          "type": "string"
        },
        "precision": {
          "const": "bf16",
          "default": "bf16",
          "title": "Precision",
          "type": "string"
        },
        "quantization": {
          "const": "none",
          "default": "none",
          "title": "Quantization",
          "type": "string"
        },
        "scheduler": {
          "const": "linear",
          "default": "linear",
          "title": "Scheduler",
          "type": "string"
        },
        "seed": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "warmup_ratio": {
          "default": 0.0,
          "maximum": 0,
          "minimum": 0,
          "title": "Warmup Ratio",
          "type": "number"
        },
        "weight_decay": {
          "default": 0.0,
          "maximum": 0,
          "minimum": 0,
          "title": "Weight Decay",
          "type": "number"
        }
      },
      "required": [
        "epochs",
        "learning_rate",
        "max_sequence_length",
        "batch_size",
        "gradient_accumulation_steps",
        "lora_rank",
        "lora_alpha",
        "lora_dropout",
        "seed"
      ],
      "title": "TrainingParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_model_name": {
      "title": "Base Model Name",
      "type": "string"
    },
    "base_model_source": {
      "$ref": "#/$defs/PlanModelSource"
    },
    "base_model_version_id": {
      "format": "uuid",
      "title": "Base Model Version Id",
      "type": "string"
    },
    "dataset_id": {
      "format": "uuid",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "dataset_name": {
      "title": "Dataset Name",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "integer"
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "example_count": {
      "exclusiveMinimum": 0,
      "title": "Example Count",
      "type": "integer"
    },
    "examples_artifact_id": {
      "format": "uuid",
      "title": "Examples Artifact Id",
      "type": "string"
    },
    "examples_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Examples Sha256",
      "type": "string"
    },
    "output": {
      "const": "lora_adapter",
      "default": "lora_adapter",
      "title": "Output",
      "type": "string"
    },
    "recipe": {
      "$ref": "#/$defs/Recipe"
    },
    "recipe_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recipe Sha256",
      "type": "string"
    },
    "schema": {
      "const": "kitchensoup.resolved-plan/v1",
      "default": "kitchensoup.resolved-plan/v1",
      "title": "Schema",
      "type": "string"
    },
    "training": {
      "$ref": "#/$defs/TrainingParameters"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "base_model_version_id",
    "base_model_name",
    "base_model_source",
    "dataset_version_id",
    "dataset_id",
    "dataset_name",
    "dataset_version",
    "dataset_manifest_sha256",
    "examples_artifact_id",
    "examples_sha256",
    "example_count",
    "recipe",
    "recipe_sha256",
    "training",
    "warnings"
  ],
  "title": "ResolvedPlan",
  "type": "object"
}
