{
  "schema": "kitchensoup.recipe/v1",
  "id": "document-adaptation-default",
  "version": 1,
  "name": "Learn from these documents",
  "intent": "learn_from_documents",
  "example_kind": "document",
  "objective": "all_text_tokens",
  "formatting": "plain_text",
  "overlength": "reject",
  "defaults": {
    "epochs": 1,
    "learning_rate": 5e-05,
    "max_sequence_length": 2048,
    "batch_size": 1,
    "gradient_accumulation_steps": 16,
    "lora_rank": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "seed": 42,
    "optimizer": "adamw",
    "precision": "bf16",
    "scheduler": "linear",
    "warmup_ratio": 0.0,
    "weight_decay": 0.0,
    "quantization": "none",
    "lora_target": "all_linear"
  }
}
